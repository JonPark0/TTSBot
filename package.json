{
  "name": "discord-tts-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord TTS bot: local Supertonic 3 card server, Gemini TTS and Google Cloud TTS, with optional Claude read-aloud normalization",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "probe": "node dist/probe.js"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "opusscript": "^0.1.1"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "tar": "^7.5.22"
  }
}
