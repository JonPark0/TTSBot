{
  "name": "discord-cf-tts-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Discord TTS bot powered by Cloudflare Workers AI (MeloTTS)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "probe": "node dist/probe.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "16.4.5",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.1.1"
  },
  "optionalDependencies": {
    "@discordjs/opus": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^5.9.3"
  }
}
