{
  // Type-checks src and test without emitting. Sources import each other with
  // `.ts` extensions so `node src/index.ts` runs them directly during development;
  // tsconfig.build.json compiles them to dist/ (rewriting the extensions to `.js`) for production.
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test"]
}
