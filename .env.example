# ─────────────────────────────────────────────────────────────
#  Discord
# ─────────────────────────────────────────────────────────────
# Bot token: https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Application (client) ID — required to register slash commands
DISCORD_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
#  Cloudflare Workers AI
# ─────────────────────────────────────────────────────────────
# Account ID: Cloudflare dashboard → Workers & Pages → (right sidebar)
CF_ACCOUNT_ID=
# API token with the "Workers AI" permission:
#   dashboard → My Profile → API Tokens → Create Token → "Workers AI" template
CF_API_TOKEN=
# TTS model ID. Default is the cheapest Korean-capable model.
CF_TTS_MODEL=@cf/myshell-ai/melotts
# Optional: route requests through an AI Gateway (caching / analytics / rate limits).
# Format: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_name>/workers-ai
CF_GATEWAY_URL=

# ─────────────────────────────────────────────────────────────
#  TTS behaviour
# ─────────────────────────────────────────────────────────────
# Language used when auto-detection cannot decide. One of: kr, en, zh, jp
TTS_DEFAULT_LANG=kr
# Max characters per message that will be spoken (also protects the free quota)
TTS_MAX_CHARS=200
# Per-guild queue cap for pending spoken messages; extras are dropped
TTS_QUEUE_MAX=20
# Leave the voice channel after this many ms with nothing left to say
TTS_IDLE_TIMEOUT_MS=300000
# Read custom emoji as their name (":smile:" -> "smile") instead of dropping them
TTS_READ_CUSTOM_EMOJI_NAMES=false
# Soft daily character budget for the whole bot (resets at 00:00 UTC). 0 disables it.
# Helps stay inside the Workers AI free allocation (10,000 Neurons/day).
TTS_DAILY_CHAR_LIMIT=100000

# ─────────────────────────────────────────────────────────────
#  Runtime
# ─────────────────────────────────────────────────────────────
DATA_DIR=./data
# error | warn | info | debug
LOG_LEVEL=info
