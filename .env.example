# ─────────────────────────────────────────────────────────────
#  Discord
# ─────────────────────────────────────────────────────────────
# Bot token: https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Application (client) ID — required to register slash commands
DISCORD_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
#  Local TTS: Supertonic 3 on an LLM-8850 (AX8850) card (optional, primary when set)
# ─────────────────────────────────────────────────────────────
# URL of server/tts_server.py running on the machine with the card (see server/README.md).
# When set, the card is the primary TTS; Gemini (if BAZE_API_KEY) and MeloTTS (if CF_*) become
# fallbacks for when the server is down or the language is unsupported (zh).
# From Docker on the same host:  http://host.docker.internal:8850  (docker-compose.yml maps it)
# Without Docker:                http://127.0.0.1:8850
LOCAL_TTS_URL=
# Voice preset: F1–F5 (female), M1–M5 (male). Empty = the server's default (--voice, F1).
LOCAL_TTS_VOICE=
# Shared secret if the server was started with TTS_SERVER_TOKEN set
LOCAL_TTS_TOKEN=
# Request timeout; a message normally takes 0.2–0.6 s on the card
LOCAL_TTS_TIMEOUT_MS=10000

# ─────────────────────────────────────────────────────────────
#  Cloudflare Workers AI
# ─────────────────────────────────────────────────────────────
# Required unless TTS_PROVIDER=local (then optional: MeloTTS is the last fallback when set).
# Account ID: Cloudflare dashboard → Workers & Pages → (right sidebar)
CF_ACCOUNT_ID=
# API token with the "Workers AI" permission:
#   dashboard → My Profile → API Tokens → Create Token → "Workers AI" template
CF_API_TOKEN=
# TTS model ID. Default is the cheapest Korean-capable model (and currently the only one).
# Only MeloTTS-compatible models work: the bot sends { prompt, lang } requests.
# (@cf/deepgram/aura-* use a different schema and speak English/Spanish only.)
CF_TTS_MODEL=@cf/myshell-ai/melotts
# Optional: route requests through an AI Gateway (caching / analytics / rate limits).
# Format: https://gateway.ai.cloudflare.com/v1/<account_id>/<gateway_name>/workers-ai
CF_GATEWAY_URL=

# ─────────────────────────────────────────────────────────────
#  Gemini TTS via BAZE API Gateway (optional, primary when set)
# ─────────────────────────────────────────────────────────────
# With a key, Gemini TTS is used first and MeloTTS (above) is the automatic fallback
# when Gemini fails, is paused after an error, or the daily credit budget is spent.
# Without a key the bot uses MeloTTS only. Usage is billed to the account that issued the key.
# Keys: BAZE → API Gateway (bottom-left sidebar). Never commit a real key.
BAZE_API_KEY=
# "local" (card server first, then Gemini, then MeloTTS), "baze" (Gemini first, MeloTTS fallback)
# or "cloudflare" (MeloTTS only). Defaults to local when LOCAL_TTS_URL is set, else baze when
# BAZE_API_KEY is set, otherwise cloudflare.
TTS_PROVIDER=
BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# gemini-3.1-flash-tts-preview (10/200 credits per 10k in/out tokens),
# gemini-2.5-flash-preview-tts (5/100, half the cost), gemini-2.5-pro-preview-tts (10/200)
BAZE_TTS_MODEL=gemini-3.1-flash-tts-preview
# Female: Kore, Aoede, Leda, Zephyr, ...  Male: Charon, Puck, Fenrir, Orus, ...
BAZE_TTS_VOICE=Kore
# Soft daily credit budget for Gemini (resets at 00:00 UTC; then MeloTTS is used). 0 disables it.
# ~2.2 credits per 25-character Korean sentence on 3.1 Flash; 900/day ~= 30,000/month.
BAZE_DAILY_CREDIT_LIMIT=900

# ─────────────────────────────────────────────────────────────
#  TTS behaviour
# ─────────────────────────────────────────────────────────────
# Language used when auto-detection cannot decide. One of: kr, en, zh, jp
TTS_DEFAULT_LANG=kr
# Max characters per message that will be spoken (also protects the free quota)
TTS_MAX_CHARS=200
# Per-guild queue cap for pending spoken messages; extras are dropped
TTS_QUEUE_MAX=20
# Leave the voice channel after this many ms with nothing left to say
TTS_IDLE_TIMEOUT_MS=300000
# Read custom emoji as their name (":smile:" -> "smile") instead of dropping them
TTS_READ_CUSTOM_EMOJI_NAMES=false
# Soft daily character budget for the cloud providers (resets at 00:00 UTC). 0 disables it.
# Helps stay inside the Workers AI free allocation (10,000 Neurons/day). Messages read by the
# local card server are free and not counted; with TTS_PROVIDER=local a spent budget only turns
# the cloud fallbacks off.
TTS_DAILY_CHAR_LIMIT=100000
# Per-language playback volume multiplier (0 < gain <= 10), applied to MeloTTS output only.
# MeloTTS renders Chinese about 4-5x quieter than the other languages, so zh is boosted
# by default. Gemini output is never boosted (it is already near full scale).
TTS_GAIN_KR=1
TTS_GAIN_JP=1
TTS_GAIN_ZH=4
TTS_GAIN_EN=1

# ─────────────────────────────────────────────────────────────
#  Runtime
# ─────────────────────────────────────────────────────────────
DATA_DIR=./data
# error | warn | info | debug
LOG_LEVEL=info
