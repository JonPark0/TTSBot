# ─────────────────────────────────────────────────────────────
#  Discord
# ─────────────────────────────────────────────────────────────
# Bot token: https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Application (client) ID — required to register slash commands
DISCORD_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
#  Local TTS: Supertonic 3 on an LLM-8850 (AX8850) card (optional, primary when set)
# ─────────────────────────────────────────────────────────────
# URL of server/tts_server.py running on the machine with the card (see server/README.md).
# When set, the card is the primary TTS; Gemini (if BAZE_API_KEY) and Google (if GOOGLE_TTS_API_KEY)
# become fallbacks for when the server is down or the language is unsupported (zh).
# From Docker on the same host:  http://host.docker.internal:8850  (docker-compose.yml maps it)
# Without Docker:                http://127.0.0.1:8850
LOCAL_TTS_URL=
# Voice preset: F1–F5 (female), M1–M5 (male). Empty = the server's default (--voice, F1).
LOCAL_TTS_VOICE=
# Shared secret if the server was started with TTS_SERVER_TOKEN set
LOCAL_TTS_TOKEN=
# Request timeout; a message normally takes 0.2–0.6 s on the card
LOCAL_TTS_TIMEOUT_MS=10000

# ─────────────────────────────────────────────────────────────
#  Gemini TTS via BAZE API Gateway (optional, primary when set)
# ─────────────────────────────────────────────────────────────
# With a key, Gemini TTS is used first and Google (below) is the automatic fallback
# when Gemini fails, is paused after an error, or the daily credit budget is spent.
# Without a key the bot uses Google only. Usage is billed to the account that issued the key.
# Keys: BAZE → API Gateway (bottom-left sidebar). Never commit a real key.
BAZE_API_KEY=
# "local" (card server first, then Gemini, then Google), "baze" (Gemini first, Google fallback)
# or "google" (Google only). Defaults to local when LOCAL_TTS_URL is set, else baze when
# BAZE_API_KEY is set, otherwise google. The old "cloudflare" (MeloTTS, retired 2026-11-20) means google.
TTS_PROVIDER=
BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# gemini-3.1-flash-tts-preview (10/200 credits per 10k in/out tokens),
# gemini-2.5-flash-preview-tts (5/100, half the cost), gemini-2.5-pro-preview-tts (10/200)
BAZE_TTS_MODEL=gemini-3.1-flash-tts-preview
# Female: Kore, Aoede, Leda, Zephyr, ...  Male: Charon, Puck, Fenrir, Orus, ...
BAZE_TTS_VOICE=Kore
# Soft daily credit budget for Gemini (resets at 00:00 UTC; then Google is used). 0 disables it.
# ~2.2 credits per 25-character Korean sentence on 3.1 Flash; 900/day ~= 30,000/month.
BAZE_DAILY_CREDIT_LIMIT=900

# ─────────────────────────────────────────────────────────────
#  Google Cloud Text-to-Speech (required with TTS_PROVIDER=google, otherwise the last fallback)
# ─────────────────────────────────────────────────────────────
# German and Italian go to Google first (then to Gemini when it is in the chain); every other
# language uses Google when the providers before it fail. The key: Google Cloud console →
# APIs & Services → Credentials → API key, restricted to the Cloud Text-to-Speech API.
GOOGLE_TTS_API_KEY=
# Voice per language; the language comes from the name. Chirp 3 HD voices take the Gemini names.
GOOGLE_TTS_VOICE_KR=ko-KR-Chirp3-HD-Kore
GOOGLE_TTS_VOICE_JP=ja-JP-Chirp3-HD-Kore
GOOGLE_TTS_VOICE_ZH=cmn-CN-Chirp3-HD-Kore
GOOGLE_TTS_VOICE_EN=en-US-Chirp3-HD-Kore
GOOGLE_TTS_VOICE_DE=de-DE-Chirp3-HD-Kore
GOOGLE_TTS_VOICE_IT=it-IT-Chirp3-HD-Kore
# Daily character budget for Google (resets at 00:00 UTC). 0 disables it.
# Chirp 3 HD is free up to 1M characters a month; 30,000/day stays inside that.
GOOGLE_TTS_DAILY_CHAR_LIMIT=30000

# ─────────────────────────────────────────────────────────────
#  TTS behaviour
# ─────────────────────────────────────────────────────────────
# Language used when auto-detection cannot decide. One of: kr, en, zh, jp, de, it
TTS_DEFAULT_LANG=kr
# Max characters per message that will be spoken (also protects the free quota)
TTS_MAX_CHARS=200
# Per-guild queue cap for pending spoken messages; extras are dropped
TTS_QUEUE_MAX=20
# Leave the voice channel after this many ms with nothing left to say
TTS_IDLE_TIMEOUT_MS=300000
# Read custom emoji as their name (":smile:" -> "smile") instead of dropping them
TTS_READ_CUSTOM_EMOJI_NAMES=false
# Soft daily character budget for the cloud providers (resets at 00:00 UTC). 0 disables it.
# Messages read by the local card server are free and not counted; with TTS_PROVIDER=local a
# spent budget only turns the cloud fallbacks off.
TTS_DAILY_CHAR_LIMIT=100000

# ─────────────────────────────────────────────────────────────
#  Read-aloud rewrite with Claude (optional)
# ─────────────────────────────────────────────────────────────
# Before the local card server or Google reads a Korean / Japanese / Chinese message that has
# digits, units, symbols or Latin letters, Claude spells them out ("10km" -> "십 킬로미터").
# Gemini gets the original (it reads these well). Failsafe: without a key, while the API is
# failing (paused 60 s, or 30 min for key / model errors), when the reply is refused or does not
# look like a rewrite, or once the daily budget is spent, the message is read as written.
# Key: platform.claude.com → API keys. Message text is sent to Anthropic.
ANTHROPIC_API_KEY=
# Set to false to turn the rewrite off while keeping the key
TTS_NORMALIZE=true
TTS_NORMALIZE_MODEL=claude-haiku-5-5
# Longest wait before reading the message unchanged
TTS_NORMALIZE_TIMEOUT_MS=1500
# Soft daily budget in USD (resets at 00:00 UTC). 0 disables it. ~$0.0001 per message.
TTS_NORMALIZE_DAILY_USD=0.3
# USD per million input / output tokens, for the budget (Claude Haiku 5.5)
TTS_NORMALIZE_PRICE_IN=0.1
TTS_NORMALIZE_PRICE_OUT=0.5
# ─────────────────────────────────────────────────────────────
#  Runtime
# ─────────────────────────────────────────────────────────────
DATA_DIR=./data
# error | warn | info | debug
LOG_LEVEL=info
